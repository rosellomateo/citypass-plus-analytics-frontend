# Fuente de datos: "api" consume el backend; "mock" permite trabajar sin levantarlo.
VITE_DATA_SOURCE=api
VITE_API_BASE_URL=http://localhost:8000

# Autenticación delegada a Login: son valores públicos, nunca tokens o secretos.
VITE_IDP_BASE_URL=https://api.citypass-login.pp.ua
VITE_AUTH_LOGIN_ENDPOINT=https://api.citypass-login.pp.ua/auth/login
VITE_AUTH_CLIENT_ID=citypass-analitica-web
VITE_AUTH_LOGIN_CLIENT_ID=citypass-admin-web

# Para ejecutar el frontend únicamente con datos de prueba:
# VITE_DATA_SOURCE=mock
