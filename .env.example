# Fuente de datos: "api" consume el backend; "mock" permite trabajar sin levantarlo.
VITE_DATA_SOURCE=api
VITE_API_BASE_URL=http://localhost:8000

# Autenticación delegada a Login: son valores públicos, nunca tokens o secretos.
VITE_AUTH_ENABLED=true
VITE_AUTH_LOGIN_ORIGIN=https://login.citypass.example
VITE_AUTH_MODULE=seguridad-urbana
# VITE_AUTH_REQUIRED_GROUP=analistas-seguridad-urbana

# Para ejecutar el frontend únicamente con datos de prueba:
# VITE_DATA_SOURCE=mock
